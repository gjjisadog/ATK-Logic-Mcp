# Build and cache directories
build/
bin/
lib/
out/
.cache/
*.obj
*.o
*.lib
*.a
*.dll
*.so
*.dylib
*.pdb
*.exe

# Allow third_party prebuilt libusb binaries
!third_party/libusb/**/libusb-1.0.lib
!third_party/libusb/**/libusb-1.0.dll
!third_party/libusb/**/libusb-1.0.a

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
dist/

# Captured data files
captures/
*.atkdl_extracted/

# Upstream reference clone (tracked externally if needed)
upstream/
third_party/libusb/*.7z
third_party/libusb/*.tar.*
